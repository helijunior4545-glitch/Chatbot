import {useEffect,useMemo,useState} from 'react';
import {DndContext,PointerSensor,KeyboardSensor,useSensor,useSensors,closestCenter,type DragEndEvent} from '@dnd-kit/core';
import {SortableContext,useSortable,verticalListSortingStrategy,arrayMove,sortableKeyboardCoordinates} from '@dnd-kit/sortable';
import {CSS} from '@dnd-kit/utilities';
import {ArrowLeft,Save,Globe,Plus,Trash2,Copy,Undo2,Redo2,Monitor,Smartphone,Download,Eye,EyeOff,GripVertical,Upload,Settings2} from 'lucide-react';
import {Link,useNavigate,useParams} from 'react-router-dom';
import type {Actor,Block,Site} from '../lib/types';
import {catalog,makeBlock,snapshot,uid} from '../lib/factory';
import {readStore,saveSite} from '../lib/local';
import {Renderer} from './Renderer';
import {downloadFile,exportStaticHtml} from '../lib/export';
function SortableBlock({block,selected,onSelect}:{block:Block;selected:boolean;onSelect:()=>void}){const {attributes,listeners,setNodeRef,transform,transition,isDragging}=useSortable({id:block.id});return <div ref={setNodeRef} style={{transform:CSS.Transform.toString(transform),transition,opacity:isDragging?.5:1}} className={`layer ${selected?'selected':''}`}><button className="drag" {...attributes} {...listeners} aria-label="Arrastar bloco"><GripVertical size={16}/></button><button className="layer-label" onClick={onSelect}><span>{block.kind}</span><strong>{block.title}</strong></button></div>}
export function Editor({actor}:{actor:Actor}){const {id}=useParams();const navigate=useNavigate();const original=useMemo(()=>{const s=readStore();const found=s.sites.find(x=>x.id===id);return found&&s.workspaces.some(w=>w.id===found.workspaceId&&w.ownerId===actor.id)?found:null},[actor.id,id]);const [site,setSite]=useState<Site|null>(original?structuredClone(original):null);const [selectedId,setSelectedId]=useState(original?.blocks[0]?.id||'');const [tab,setTab]=useState<'blocks'|'theme'|'settings'>('blocks');const [device,setDevice]=useState<'desktop'|'mobile'>('desktop');const [history,setHistory]=useState<Site[]>([]);const [future,setFuture]=useState<Site[]>([]);const [dirty,setDirty]=useState(false);const sensors=useSensors(useSensor(PointerSensor,{activationConstraint:{distance:5}}),useSensor(KeyboardSensor,{coordinateGetter:sortableKeyboardCoordinates}));useEffect(()=>{const listener=(e:KeyboardEvent)=>{if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='s'){e.preventDefault();document.getElementById('pf-save')?.click();}};window.addEventListener('keydown',listener);return()=>window.removeEventListener('keydown',listener)},[]);
if(!site)return <main className="empty"><h2>Página não encontrada ou sem acesso</h2><Link to="/dashboard">Voltar</Link></main>;
const selected=site.blocks.find(b=>b.id===selectedId);
const apply=(fn:(s:Site)=>Site)=>{setHistory(h=>[...h.slice(-49),structuredClone(site)]);setFuture([]);setSite(fn(structuredClone(site)));setDirty(true)};
const patch=(updates:Partial<Block>)=>apply(s=>({...s,blocks:s.blocks.map(b=>b.id===selectedId?{...b,...updates}:b)}));
const save=(publish=false)=>{try{const updated:Site={...site,version:site.version+(publish?1:0),published:publish||site.published,publishedSnapshot:publish?null:site.publishedSnapshot};if(publish)updated.publishedSnapshot=snapshot(updated);const saved=saveSite(actor,updated);setSite(saved);setDirty(false);alert(publish?'Página publicada!':'Rascunho salvo!')}catch(e){alert(String(e))}};
const undo=()=>{if(!history.length)return;setFuture(f=>[site,...f]);setSite(history.at(-1)!);setHistory(h=>h.slice(0,-1));setDirty(true)};const redo=()=>{if(!future.length)return;setHistory(h=>[...h,site]);setSite(future[0]);setFuture(f=>f.slice(1));setDirty(true)};
const dragEnd=(e:DragEndEvent)=>{const {active,over}=e;if(over&&active.id!==over.id)apply(s=>{const a=s.blocks.findIndex(b=>b.id===active.id),b=s.blocks.findIndex(x=>x.id===over.id);return {...s,blocks:arrayMove(s.blocks,a,b)}})};
const upload=(file:File)=>{if(file.size>2_000_000){alert('No modo local, imagens devem ter até 2 MB.');return;}const reader=new FileReader();reader.onload=()=>patch({image:String(reader.result)});reader.readAsDataURL(file)};
return <div className="editor"><header className="editor-top"><Link to="/dashboard" className="iconbtn"><ArrowLeft size={18}/></Link><div className="editor-heading"><strong>{site.name}</strong><small>{dirty?'Alterações não salvas':'Rascunho atualizado'} · v{site.version}</small></div><div className="editor-top-actions"><button className="iconbtn" title="Desfazer" onClick={undo} disabled={!history.length}><Undo2 size={17}/></button><button className="iconbtn" title="Refazer" onClick={redo} disabled={!future.length}><Redo2 size={17}/></button><button className={`iconbtn ${device==='desktop'?'active':''}`} onClick={()=>setDevice('desktop')}><Monitor size={17}/></button><button className={`iconbtn ${device==='mobile'?'active':''}`} onClick={()=>setDevice('mobile')}><Smartphone size={17}/></button><button className="btn secondary" onClick={()=>downloadFile(`${site.slug}.json`,JSON.stringify(site,null,2),'application/json')}><Download size={16}/> JSON</button><button className="btn secondary" onClick={()=>downloadFile(`${site.slug}.html`,exportStaticHtml(site),'text/html')}><Download size={16}/> HTML</button><button id="pf-save" className="btn secondary" onClick={()=>save()}><Save size={16}/> Salvar</button><button className="btn primary" onClick={()=>save(true)}><Globe size={16}/> Publicar</button></div></header><div className="editor-body"><aside className="editor-sidebar"><div className="editor-tabs"><button className={tab==='blocks'?'active':''} onClick={()=>setTab('blocks')}>Blocos</button><button className={tab==='theme'?'active':''} onClick={()=>setTab('theme')}>Estilo</button><button className={tab==='settings'?'active':''} onClick={()=>setTab('settings')}>Site</button></div>{tab==='blocks'&&<><div className="sidebar-heading"><strong>Estrutura da página</strong><small>Arraste para reordenar</small></div><DndContext sensors={sensors} collisionDetection={closestCenter} onDragEnd={dragEnd}><SortableContext items={site.blocks.map(b=>b.id)} strategy={verticalListSortingStrategy}><div className="layers">{site.blocks.map(b=><SortableBlock key={b.id} block={b} selected={selectedId===b.id} onSelect={()=>setSelectedId(b.id)}/>)}</div></SortableContext></DndContext><div className="sidebar-heading"><strong>Adicionar seção</strong></div><div className="catalog">{catalog.map(c=><button key={c.kind} onClick={()=>{const b=makeBlock(c.kind);apply(s=>({...s,blocks:[...s.blocks,b]}));setSelectedId(b.id)}}><Plus size={15}/><span><strong>{c.name}</strong><small>{c.description}</small></span></button>)}</div></>}{tab==='theme'&&<div className="properties"><h3>Identidade visual</h3>{(['primary','surface','text'] as const).map(k=><label key={k}>{k==='primary'?'Cor principal':k==='surface'?'Fundo':'Cor do texto'}<input type="color" value={site.theme[k]} onChange={e=>apply(s=>({...s,theme:{...s.theme,[k]:e.target.value}}))}/></label>)}<label>Arredondamento <input type="range" min="0" max="40" value={site.theme.radius} onChange={e=>apply(s=>({...s,theme:{...s.theme,radius:Number(e.target.value)}}))}/></label><label>Fonte<select value={site.theme.font} onChange={e=>apply(s=>({...s,theme:{...s.theme,font:e.target.value}}))}><option value="Inter, system-ui, sans-serif">Inter / Sistema</option><option value="Georgia, serif">Georgia</option><option value="Arial, sans-serif">Arial</option><option value="Verdana, sans-serif">Verdana</option></select></label></div>}{tab==='settings'&&<div className="properties"><h3>Configuração da página</h3><label>Nome<input value={site.name} onChange={e=>apply(s=>({...s,name:e.target.value}))}/></label><label>Slug<input value={site.slug} onChange={e=>apply(s=>({...s,slug:e.target.value.toLowerCase().replace(/[^a-z0-9-]/g,'-')}))}/></label><label>Descrição<textarea value={site.description} onChange={e=>apply(s=>({...s,description:e.target.value}))}/></label>{site.published&&<Link className="btn secondary" to={`/p/${site.publishedSnapshot?.slug||site.slug}`} target="_blank">Ver versão publicada ↗</Link>}<button className="btn secondary" onClick={()=>navigate('/dashboard')}>Voltar ao painel</button></div>}</aside><main className="editor-stage"><div className={`canvas-frame ${device}`}><Renderer blocks={site.blocks} theme={site.theme}/></div></main><aside className="inspector"><div className="inspector-head"><Settings2 size={17}/><strong>Propriedades</strong></div>{selected?<div className="properties"><div className="inspector-kind">{selected.kind.toUpperCase()}</div><label>Título<input value={selected.title} onChange={e=>patch({title:e.target.value})}/></label><label>Subtítulo<textarea value={selected.subtitle} onChange={e=>patch({subtitle:e.target.value})}/></label><label>Texto<textarea value={selected.body} onChange={e=>patch({body:e.target.value})}/></label><label>Itens (uma linha por item)<textarea rows={4} value={selected.items.join('
')} onChange={e=>patch({items:e.target.value.split('
')})}/></label><label>Texto do botão<input value={selected.buttonText} onChange={e=>patch({buttonText:e.target.value})}/></label><label>Link do botão<input value={selected.buttonUrl} onChange={e=>patch({buttonUrl:e.target.value})}/></label><label>URL da imagem<input value={selected.image} onChange={e=>patch({image:e.target.value})}/></label><label className="upload-label"><Upload size={15}/> Carregar imagem<input type="file" accept="image/*" onChange={e=>{const f=e.target.files?.[0];if(f)upload(f)}}/></label><label>Cor de fundo<input type="color" value={selected.background||site.theme.surface} onChange={e=>patch({background:e.target.value})}/></label><label>Cor do texto<input type="color" value={selected.foreground||site.theme.text} onChange={e=>patch({foreground:e.target.value})}/></label><label>Alinhamento<select value={selected.align} onChange={e=>patch({align:e.target.value as Block['align']})}><option value="left">Esquerda</option><option value="center">Centro</option></select></label><div className="property-actions"><button className="btn secondary" onClick={()=>patch({enabled:!selected.enabled})}>{selected.enabled?<EyeOff size={15}/>:<Eye size={15}/>} {selected.enabled?'Ocultar':'Exibir'}</button><button className="btn secondary" onClick={()=>{const copy={...structuredClone(selected),id:uid()};apply(s=>({...s,blocks:[...s.blocks.slice(0,s.blocks.findIndex(b=>b.id===selected.id)+1),copy,...s.blocks.slice(s.blocks.findIndex(b=>b.id===selected.id)+1)]}));setSelectedId(copy.id)}}><Copy size={15}/> Duplicar</button><button className="btn danger" onClick={()=>{apply(s=>({...s,blocks:s.blocks.filter(b=>b.id!==selected.id)}));setSelectedId(site.blocks.find(b=>b.id!==selected.id)?.id||'')}}><Trash2 size={15}/> Excluir</button></div></div>:<p className="muted pad">Selecione um bloco para editar.</p>}</aside></div></div>}
